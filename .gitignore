# env files (can opt-in for committing if needed)
.env*
!.env.example

# design assets (visual reference only)
/design
/docs/hackathon/

# internal process docs (not public-facing)
/docs/process/

# bmad framework (symlinked, not project code)
_bmad/
_bmad-output/

# worktrees
.worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stellar seller secret (never commit; move to treasury password manager)
.stellar-seller-secret
.stellar-buyer-secret
.stellar-e2e-payment
